ENV=development
DEBUG=false

# Ports are remapped to 5433/6380 on the host to avoid clashing with a
# locally-installed Postgres/Redis. When running the api itself inside
# docker compose, these are overridden to the in-network hostnames/ports.
DATABASE_URL=postgresql+asyncpg://callcenter:callcenter@localhost:5433/callcenter
REDIS_URL=redis://localhost:6380/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
# Signs Exotel call-status links. Must be different from JWT_SECRET_KEY.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EXOTEL_WEBHOOK_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Must be a valid Fernet key (unlike the other secrets here, this one has a
# strict format — a plain placeholder string will crash on first use).
# The value below is a working dev-only key; generate a real one for
# anything beyond local dev with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=hF1c3zL1Yv8m3q9y6t2u5b7n0k4j8h1s2d5f8g1h4j7=

# Shared secret between the FastAPI api and the Go realtime gateway for
# internal/* endpoints. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=change-me-in-production

# --- Voice (Twilio call carrier + Sarvam STT/TTS/LLM) ---
# wss:// address of the Go realtime gateway's Twilio Media Stream endpoint.
# In docker compose this is the `realtime` service; for local dev without
# docker you'll need a public tunnel (e.g. ngrok) since Twilio must reach it.
REALTIME_WS_URL=wss://localhost:9000/ws/twilio

# From twilio.com/console — used to place outbound calls and validate
# inbound webhook signatures.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public https:// origin of the FastAPI service, exactly as configured in
# Twilio — required for request-signature validation and for building
# webhook/outbound-call callback URLs. Needs a public tunnel (e.g. ngrok)
# for local dev, since Twilio must be able to reach it.
PUBLIC_BASE_URL=http://localhost:8000
# E.164 number to <Dial> when an AI agent calls the transfer_call tool. If
# unset, a transfer just speaks the handoff message and hangs up.
TRANSFER_FALLBACK_NUMBER=

# From the Sarvam dashboard. Used by both the FastAPI api (chat/LLM tool-
# calling turns) and the Go realtime gateway (STT/TTS) — the gateway reads
# this same variable directly, not through the Python settings.
SARVAM_API_KEY=

# --- WhatsApp (Meta Cloud API, Tech Provider model: one app/webhook shared
# across tenants; each tenant's own phone_number_id + token live in the
# whatsapp_accounts table, encrypted) ---
META_WHATSAPP_APP_SECRET=
# Arbitrary string you also enter in the Meta App Dashboard webhook config.
META_WHATSAPP_VERIFY_TOKEN=change-me-in-production
META_GRAPH_API_VERSION=v21.0

# --- Razorpay (payment links tool for tenants' customer-facing calls, AND
# platform billing subscriptions — see app/api/v1/billing.py) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- PayPal (wallet top-ups). Apps & Credentials on developer.paypal.com.
# Webhook: {PUBLIC_BASE_URL}/api/v1/webhooks/payment/paypal
# Events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED.
# Mode is sandbox or live. Leave the secret empty until you have it. ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# --- Transactional email (password reset, email verification). Leave
# SMTP_HOST unset for local dev — app/integrations/email_client.py logs the
# email instead of sending it. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

# Base URL of the tenant-facing frontend, used to build links embedded in
# transactional emails (password reset, email verification).
FRONTEND_BASE_URL=http://localhost:3000

# Seconds between consecutive campaign sends (throttle against Twilio/Meta limits).
CAMPAIGN_VOICE_INTERVAL_SECONDS=1.0
CAMPAIGN_WHATSAPP_INTERVAL_SECONDS=0.2
CAMPAIGN_MAX_SEND_ATTEMPTS=3
CAMPAIGN_RETRY_BACKOFF_SECONDS=2.0

# =====================================================================
# Added for the new modules. Fill in the empty values; defaults shown
# are safe for local development.
# =====================================================================

# --- Go realtime gateway (apps/realtime reads these from its own environment) ---
BACKEND_BASE_URL=http://localhost:8000
DEFAULT_LANGUAGE=en-IN
PORT=9000

# --- Email: SMTP (password reset, verification, the email channel). Empty SMTP_HOST = emails are logged, not sent ---

# --- Frontend link base used inside emails ---

# --- Security: honour X-Forwarded-For for the IP allowlist. ONLY true behind a proxy that overwrites the header ---
TRUST_X_FORWARDED_FOR=false

# --- Limits and pacing ---
API_KEY_RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_CALLS_PER_TENANT=10

# --- Indicative cost rates (paise) for usage and AI-cost analytics. Not billing ---
USAGE_PAISE_PER_CALL_MINUTE=600
USAGE_PAISE_PER_WHATSAPP_MESSAGE=50
AI_CALL_COST_PAISE_PER_MINUTE=400

# NOTE: these are NOT .env values. Enter them per business in the app (stored encrypted in the database):
#  - Instagram / Messenger page tokens, per-channel Meta app secret   -> /channels
#  - SSO (OIDC issuer, client id, client secret)                      -> /settings/security
#  - HubSpot, Zoho, Zendesk, Freshdesk, Shopify, WooCommerce, Slack,
#    Teams, Zapier, Make, n8n credentials                             -> /integrations/hub
#  - Each business's own WhatsApp number and token                    -> /whatsapp
# Instagram, Messenger and WhatsApp webhooks fall back to META_WHATSAPP_APP_SECRET above when no per-channel secret is set.

# =============================================================================
# Per-tenant OAuth: the PLATFORM's own OAuth app per provider. Leave empty to
# disable a provider (its Connect button then reports "provider_not_configured").
# Every business authorizes with these apps; THEIR tokens are stored encrypted
# in the database, never here. Redirect URIs (register in each console):
#   {PUBLIC_BASE_URL}/api/v1/oauth/<provider>/callback
#   plus, for Google and Microsoft sign-in:
#   {PUBLIC_BASE_URL}/api/v1/auth/oauth/<provider>/callback
# Setup checklist per provider: docs/OAUTH_SETUP.md
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = work/school + personal accounts (leave empty for the default)
MICROSOFT_TENANT_ID=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Empty = https://login.salesforce.com (use https://test.salesforce.com for sandboxes)
SALESFORCE_LOGIN_URL=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Data centre of the Zoho API console client, e.g. https://accounts.zoho.in (empty = .com)
ZOHO_ACCOUNTS_DOMAIN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
META_APP_ID=
# Empty = falls back to META_WHATSAPP_APP_SECRET (same Meta app)
META_APP_SECRET=
# Optional Facebook Login for Business configuration id (sent instead of scopes)
META_LOGIN_CONFIG_ID=
# WhatsApp Embedded Signup configuration id (Tech Provider apps only)
META_WHATSAPP_CONFIG_ID=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Plan a brand-new workspace starts on: free (10 AI call minutes, see docs/BILLING.md),
# starter, growth, scale, enterprise, or legacy (unlimited, like workspaces that predate plans).
SIGNUP_PLAN_TIER=free
