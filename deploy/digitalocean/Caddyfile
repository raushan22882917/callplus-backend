{
	email {$ACME_EMAIL}
}

# The dashboard. For a backend-only server set APP_DOMAIN=http://localhost:8081 (plain HTTP,
# no certificate is requested and nothing public is served).
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:3000
}

# One address for everything people use: the dashboard and the API together. The API (and the chat
# widget script, webhooks, OAuth and the MCP server) answers on its own paths; every other address is
# the dashboard. This is the address to share with clients; a separate app.* name is optional above.
{$API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	@backend path /api/* /mcp /mcp/* /oauth/* /.well-known/* /healthz
	handle @backend {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}

# Twilio's live-call audio stream (a WebSocket; Caddy proxies upgrades by itself)
{$REALTIME_DOMAIN} {
	reverse_proxy realtime:9000 {
		header_up X-Forwarded-For {remote_host}
	}
}
