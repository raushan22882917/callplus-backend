{
	email {$ACME_EMAIL}
}

# The dashboard
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:3000
}

# The API, the chat widget script, webhooks and the MCP server
{$API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {remote_host}
	}
}

# Twilio's live-call audio stream (a WebSocket; Caddy proxies upgrades by itself)
{$REALTIME_DOMAIN} {
	reverse_proxy realtime:9000 {
		header_up X-Forwarded-For {remote_host}
	}
}
