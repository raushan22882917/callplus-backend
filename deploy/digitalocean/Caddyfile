{
	email {$ACME_EMAIL}
}

# The dashboard. For a backend-only server set APP_DOMAIN=http://localhost:8081 (plain HTTP,
# no certificate is requested and nothing public is served).
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:3000
}

# One address for everything people use: the dashboard and the API together. The API (and the chat
# widget script, webhooks, OAuth and the MCP server) answers on its own paths; every other address is
# the dashboard. This is the address to share with clients; a separate app.* name is optional above.
{$API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	@backend path /api/* /mcp /mcp/* /oauth/* /.well-known/* /healthz
	handle @backend {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}

# Twilio's live-call audio stream (a WebSocket; Caddy proxies upgrades by itself)
{$REALTIME_DOMAIN} {
	reverse_proxy realtime:9000 {
		header_up X-Forwarded-For {remote_host}
	}
}

# Other apps that share this server and its Caddy. They live here because deploy.sh replaces the server's
# Caddyfile with this file; a block added only on the server disappears at the next deploy and Caddy
# then has no certificate for the site (browsers show ERR_SSL_PROTOCOL_ERROR).
# Both containers join the digitalocean_internal network by name.

# WebToApp
web2app.autobot360.com {
	encode zstd gzip
	reverse_proxy webtoapp-web-1:3000
}

# Notemaker
notemaker.autobot360.com {
	encode gzip
	reverse_proxy deploy-app-1:3000
}
