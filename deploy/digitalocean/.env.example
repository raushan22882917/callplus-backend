# Copy to .env on the server (chmod 600) and fill in. Never commit .env.
# Generate secrets with ./gen-secrets.sh

# ---- where it lives ----
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
REALTIME_DOMAIN=rt.example.com
ACME_EMAIL=you@example.com

# The address people open the dashboard at (used in email links). If the dashboard is hosted
# elsewhere and this server is backend-only, set APP_DOMAIN=http://localhost:8081 above.
FRONTEND_URL=https://app.example.com

# Websites allowed to call the API from a browser (JSON list). List the dashboard wherever it runs.
CORS_ORIGINS_JSON=["https://app.example.com"]

# ---- generated secrets ----
POSTGRES_PASSWORD=
# Password for callcenter_app, the non-superuser role the API connects as.
# Generate a second random value. Required so row-level security is enforced.
APP_DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET_KEY=
EXOTEL_WEBHOOK_SECRET=
INTERNAL_SERVICE_TOKEN=
ENCRYPTION_KEY=

# ---- providers ----
SARVAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TRANSFER_FALLBACK_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

# ---- invoices for wallet top-ups ----
SELLER_LEGAL_NAME=
SELLER_GSTIN=
SELLER_STATE_CODE=
SELLER_ADDRESS=

# ---- email (optional; without it, emails are only logged) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ---- plan new workspaces start on: free (10-minute trial) or payg (wallet) ----
SIGNUP_PLAN_TIER=free

# Optional: public key of a web chat channel (with "voice calls from the browser" ticked) that the
# marketing site's "Talk to our AI" button calls. Leave empty to hide the button.
WEB_CALL_DEMO_KEY=

# ---- Optional: CallPlus-provided voice and AI ----
# SARVAM_API_KEY above is the included price: workspaces use it and minutes come out of the plan or wallet.
# A workspace can still paste its own Sarvam key (Integrations). Then it pays Sarvam and those minutes are not charged.
# List only the extras here. Providers: deepgram, elevenlabs, llm. Each also needs its key below.
MANAGED_PROVIDERS=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# "llm" with no separate model below means Sarvam's model on the platform's SARVAM_API_KEY.
MANAGED_LLM_API_KEY=
MANAGED_LLM_URL=
MANAGED_LLM_MODEL=
# Extra minutes counted per call minute when a call uses that provider on the platform's account (starting points:
# check them against your providers' invoices). elevenlabs:1 means a call counts two minutes per minute.
MANAGED_MINUTE_EXTRAS=deepgram:0.2,elevenlabs:1,llm:0
