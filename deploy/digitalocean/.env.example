# Copy to .env on the server (chmod 600) and fill in. Never commit .env.
# Generate secrets with ./gen-secrets.sh

# ---- where it lives ----
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
REALTIME_DOMAIN=rt.example.com
ACME_EMAIL=you@example.com

# The address people open the dashboard at (used in email links). If the dashboard is hosted
# elsewhere and this server is backend-only, set APP_DOMAIN=http://localhost:8081 above.
FRONTEND_URL=https://app.example.com

# Websites allowed to call the API from a browser (JSON list). List the dashboard wherever it runs.
CORS_ORIGINS_JSON=["https://app.example.com"]

# ---- generated secrets ----
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET_KEY=
INTERNAL_SERVICE_TOKEN=
ENCRYPTION_KEY=

# ---- providers ----
SARVAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TRANSFER_FALLBACK_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

# ---- invoices for wallet top-ups ----
SELLER_LEGAL_NAME=
SELLER_GSTIN=
SELLER_STATE_CODE=
SELLER_ADDRESS=

# ---- email (optional; without it, emails are only logged) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ---- plan new workspaces start on: free (10-minute trial) or payg (wallet) ----
SIGNUP_PLAN_TIER=free
